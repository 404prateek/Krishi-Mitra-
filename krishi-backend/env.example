# ─── Krishi Mitra Backend — Environment Variables ─────────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to git.

# ── Gemini ─────────────────────────────────────────────────────────────────────
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Weather ────────────────────────────────────────────────────────────────────
# OpenWeather API key: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_api_key_here

# ── Market data ────────────────────────────────────────────────────────────────
# Agmarknet / data.gov.in API key
AGMARKNET_KEY=your_agmarknet_api_key_here

# ── Voice transcription ───────────────────────────────────────────────────────
# OpenAI-compatible Whisper API key
WHISPER_API_KEY=your_whisper_api_key_here
WHISPER_BASE_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1

# ── Schemes source ────────────────────────────────────────────────────────────
# Optional gov.in / data.gov.in endpoint that returns scheme records
GOV_SCHEMES_URL=

# ── ML Model ───────────────────────────────────────────────────────────────────
# Path to your trained MobileNetV2 .h5 file (default / legacy)
MODEL_PATH=./model/krishi_model.h5

# ── SMS (Fast2SMS) ─────────────────────────────────────────────────────────────
# Get your key at: https://www.fast2sms.com/dashboard/dev → Developer API
# Free tier (route "v") works only for numbers registered in your sender panel.
# For production, complete DLT registration with TRAI and use route "q".
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Set to "true" while your model is still training — the server will run
# fine and return random predictions so you can test the full pipeline.
USE_MOCK_MODEL=false

# ── ResNet50 + XGBoost hybrid model (optional, better accuracy) ───────────────
# After running train_resnet50_xgboost.py, uncomment and set this path.
# The server will auto-switch to ResNet50+XGBoost when this variable is present.
# Leave blank (or remove) to keep using the MobileNetV2 Keras model.
# XGB_MODEL_PATH=./model/xgb_model.pkl

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS — which frontend URLs are allowed to call this server ─────────────────
# Local dev: keep defaults. Production: set to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
